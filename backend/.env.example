# Copiar este archivo a .env y completar con valores reales (nunca commitear .env)

# Postgres — usado tanto por la app como por docker-compose (servicio "db")
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/pay_and_check

# JWT propio de la app (emitido tanto para login por email/contraseña como por Google)
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token: lo usa la app móvil para renovar el access token sin volver a loguear
REFRESH_TOKEN_EXPIRE_DAYS=30

# Groq (parseo de lenguaje natural)
GROQ_API_KEY=

# Google Identity Services — Client ID de tipo "aplicación web" creado en
# https://console.cloud.google.com/ (pantalla de consentimiento OAuth + credencial)
GOOGLE_CLIENT_ID=

# Orígenes permitidos por CORS (separados por coma). Agregada en la Fase 1:
# no estaba prevista en la Fase 0, pero CORS la necesita.
CORS_ORIGINS=http://localhost:5173

