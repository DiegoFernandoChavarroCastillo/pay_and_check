<?xml version="1.0" encoding="utf-8"?>
<!-- Widget del número del día. Colores fijos de la marca: los widgets no siguen el tema de Flutter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_raiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/daily_widget_fondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_etiqueta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Disponible hoy"
            android:textColor="#B9E8D8"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/widget_monto"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text="—"
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_detalle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"
            android:text=""
            android:textColor="#B9E8D8"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_registrar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/daily_widget_boton"
        android:paddingHorizontal="14dp"
        android:paddingVertical="10dp"
        android:text="+ Registrar"
        android:textColor="#0F2A23"
        android:textSize="14sp"
        android:textStyle="bold" />
</LinearLayout>
